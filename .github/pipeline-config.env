# Valores propios de esta capa. Es lo único que cambia entre los tres repositorios.
APP_NAME=transfers-experience-api
VALIDATE_FLAGS=--require-autodiscovery
APPLY_POLICIES=true
RUN_SMOKE_TEST=true
# Nombre de la clave del id de la instancia de API en los YAML de configuración
AUTODISCOVERY_KEY=api.id
