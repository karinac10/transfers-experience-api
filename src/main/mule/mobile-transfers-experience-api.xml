<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="mobile-transfers-experience-api-httpListenerConfig">
        <http:listener-connection host="${secure::https.listener.host}" port="${secure::https.listener.port}" />
    </http:listener-config>
    <apikit:config name="mobile-transfers-experience-api-config" api="resource::c9dbcdc8-e2b1-421f-aeb3-ddbe856d4e2f:mobile-transfers-experience-api:1.0.1:raml:zip:mobile-transfers-experience-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="mobile-transfers-experience-api-main">
        <http:listener config-ref="mobile-transfers-experience-api-httpListenerConfig" path="${secure::https.listener.path}">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref doc:name="global_apiEntryPoint" doc:id="91808129-3824-49c3-8ebe-2dad871f867d" name="global_apiEntryPoint" />
        <apikit:router config-ref="mobile-transfers-experience-api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="400 Bad Request">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "La solicitud contiene datos inválidos. " ++ error.detailedDescription,
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="404 Not Found">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "La ruta solicitada no existe.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="405 Method Not Allowed">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "El método no está permitido para este recurso.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="406 Not Acceptable">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "El formato de respuesta solicitado no es aceptable.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="415 Unsupported Media Type">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "El tipo de media del cuerpo no es soportado.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="501 Not Implemented">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "La operación no está implementada.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="68b7fd00-9bf7-4aa7-b91e-833e5bfc5f2b" type="APP:INVALID_PAYLOAD">
                <ee:transform doc:name="400 Invalid Payload" doc:id="807bd91e-5eeb-48d1-a29f-f1782cb0e349">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:        "VALIDACION_ERROR",
  mensaje:       "El cuerpo de la solicitud no es un JSON válido.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="get:\transferencias\(id):mobile-transfers-experience-api-config">
        <logger level="INFO" doc:name="START" doc:id="b8c9d0e1-f2a3-4567-bb88-990123456121" message="START: Inicialización del flujo: #[vars.flowVar] para #[app.name] con transactionId:  #[vars.transactionId]" />
        <flow-ref doc:name="get-transferencia-experience-impl-sf" doc:id="c9d0e1f2-a3b4-5678-cc99-001234567122" name="get-transferencia-experience-impl-sf" />
        <logger level="INFO" doc:name="END" doc:id="d0e1f2a3-b4c5-6789-dd00-112345678123" message="END: Finalización del flujo: #[vars.flowVar] para #[app.name] con transactionId: #[vars.transactionId]" />
        <error-handler ref="global-error-handler" />
    </flow>
    <flow name="post:\transferencias:application\json:mobile-transfers-experience-api-config">
        <logger level="INFO" doc:name="START" doc:id="e1f2a3b4-c5d6-7890-ee11-223456789124" message="START: Inicialización del flujo: #[vars.flowVar] para #[app.name] con transactionId:  #[vars.transactionId]" />
        <flow-ref doc:name="post-transferencias-experience-impl-sf" doc:id="f2a3b4c5-d6e7-8901-ff22-334567890125" name="post-transferencias-experience-impl-sf" />
        <logger level="INFO" doc:name="END" doc:id="a3b4c5d6-e7f8-9012-aa33-445678901126" message="END: Finalización del flujo: #[vars.flowVar] para #[app.name] con transactionId: #[vars.transactionId]" />
        <error-handler ref="global-error-handler" />
    </flow>
</mule>
