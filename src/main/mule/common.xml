<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        Global error handler — referenciar con <error-handler ref="global-error-handler"/> en cada flow.
        Cubre: connectivity, timeout, errores de negocio TRANSFERENCIA:* y catch-all.
    -->
    <error-handler name="global-error-handler">

        <on-error-propagate type="APP:MISSING_IDEMPOTENCY_KEY" logException="false" doc:name="400 X-Idempotency-Key requerido">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:  "VALIDACION_ERROR",
  mensaje: "El header X-Idempotency-Key es obligatorio para esta operación.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="APP:TRANSFER_NOT_FOUND" logException="false" doc:name="404 Transferencia no encontrada">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:    "TRANSFERENCIA_NO_ENCONTRADA",
  mensaje:   "La transferencia solicitada no fue encontrada.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="HTTP:CONNECTIVITY" logException="false" doc:name="503 Process API no disponible">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:    "SERVICIO_NO_DISPONIBLE",
  mensaje:   "El servicio de transferencias no está disponible. Intente más tarde.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">503</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="HTTP:TIMEOUT" logException="false" doc:name="504 Timeout">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:    "TIMEOUT",
  mensaje:   "El servicio de transferencias no respondió a tiempo.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">504</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="ANY" logException="true" doc:name="500 Error inesperado">
            <logger level="ERROR" doc:name="Log error"
    message="#[%dw 2.0&#10;        output text/plain&#10;        ---&#10;        '[ERROR] flujo: ' ++&#10;        ((vars.flowVar default 'N/A') as String) ++&#10;        ' | transactionId: ' ++&#10;        ((vars.transactionId default 'N/A') as String) ++&#10;        ' | ' ++&#10;        ((error.description default 'Error al procesar la solicitud de transferencia.') as String)]"/>
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  codigo:    "ERROR_INTERNO",
  mensaje:   "Ocurrió un error inesperado. El servicio de transferencias no pudo completar la solicitud.",
  correlationId: vars.transactionId default "",
  timestamp:     now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

    </error-handler>

    <!-- Logging estructurado de entrada -->
    <sub-flow name="global_apiEntryPoint" doc:id="961da81e-755b-4d90-8962-7434cdc44599" >
		<try doc:name="Validate Request Payload" doc:id="79593c95-0755-411a-bd1f-ac66000b7a86" >
			<ee:transform doc:name="Check Request Payload" doc:id="34fb0e22-bf26-4d97-84a3-8bfa7184237d" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (attributes.method == "GET" or isEmpty(attributes.method))
    {}
else
    payload as Object]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<error-handler >
				<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="39754114-6f6d-46df-8547-42fae80e31e4" type="MULE:EXPRESSION" >
					<raise-error doc:name="Raise Validation BAD_REQUEST" doc:id="f68f59c7-91b4-4832-8b03-9c7ad4d19821" type="APP:INVALID_PAYLOAD" />
				</on-error-propagate>
			</error-handler>
		</try>
		<ee:transform doc:name="transactionId, startTime, idempotencyKey and incomingAttr" doc:id="998ca84e-48cc-4dad-8d60-248de6714d15" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="transactionId" ><![CDATA[%dw 2.0
output application/java
---
attributes.headers."x-correlation-id" default uuid()]]></ee:set-variable>
				<ee:set-variable variableName="startTime" ><![CDATA[%dw 2.0
output application/java
---
now() as Number {unit: "milliseconds"}]]></ee:set-variable>
				<ee:set-variable variableName="idempotencyKey" ><![CDATA[%dw 2.0
output application/java
---
attributes.headers."X-Idempotency-Key"]]></ee:set-variable>
				<ee:set-variable variableName="incomingAttr" ><![CDATA[%dw 2.0
output application/json
---
message.attributes]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="flowVar" doc:id="0a303f55-371e-41fe-9e69-22d3b9436a21" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="flowVar" ><![CDATA[%dw 2.0
output application/json
---
vars.incomingAttr.requestUri]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
	<sub-flow name="log-request-sf">
        <logger level="INFO"
            message="#['[' ++ correlationId ++ '] REQUEST ' ++ (attributes.method default '') ++ ' ' ++ (attributes.requestPath default '') ++ ' | idempotencyKey=' ++ (attributes.headers.'x-idempotency-key' default 'N/A')]"
            doc:name="Log Request"/>
    </sub-flow>

    <!-- Logging estructurado de salida -->
    <sub-flow name="log-response-sf">
        <logger level="INFO"
            message="#['[' ++ correlationId ++ '] RESPONSE status=' ++ ((vars.httpStatus default 200) as String)]"
            doc:name="Log Response"/>
    </sub-flow>
    

</mule>
