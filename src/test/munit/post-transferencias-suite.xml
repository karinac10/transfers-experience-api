    <!-- ================================================================
         T8 — exp-post-t8-rejected-422
         Mock Process API retorna Rejected con StatusReason INSUFFICIENT_FUNDS
         Valida: httpStatus=422, payload.codigo=SALDO_INSUFICIENTE
         ================================================================ -->
    <munit:test name="exp-post-t8-rejected-422"
                description="POST transferencias: Process responde Rejected INSUFFICIENT_FUNDS → 422 SALDO_INSUFICIENTE"
                doc:id="bb000070-0008-0008-0008-000000000070">

        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:id="bb000071-0008-0008-0008-000000000071">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="POST Process API /PaymentOrder/Initiate"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/json"
                        value='#[output application/json --- {PayerProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "100200300"}}}}}, PayeeProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "900800700"}}}}}, PayeeBankReference: {PartyReference: {PartyIdentification: {PartyIdentification: {IdentifierValue: {Value: "BAT-0088"}}}}}, Amount: {AmountValue: {Value: "150.75"}, AmountCurrency: {Currencycode: "USD"}}, Currency: {Currencycode: "USD"}, DateType: "Creationdate", Date: {DateTimeContent: "2026-10-01T14:32:10-06:00"}, PaymentMechanismType: "ACH", PaymentInstructions: {PaymentInstructionType: "Domesticpayment", PaymentInstructionStatus: {PaymentInstructionStatusType: "Rejected", PaymentInstructionStatus: {StatusReason: {Text: "INSUFFICIENT_FUNDS"}, StatusDateTime: {DateTimeContent: "2026-10-18T20:00:00Z"}}}}, RemittanceInformation: {Text: "Pago de prueba"}}]'/>
                    <munit-tools:attributes
                        value='#[output application/java --- {statusCode: 200, headers: {"X-Payment-Order-Id": "test-order-e2e-uuid-001", "Location": "/payment-order/PaymentOrder/test-order-e2e-uuid-001/Retrieve"}}]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="bb000072-0008-0008-0008-000000000072">
                <munit-tools:payload
                    mediaType="application/json"
                    value='#[output application/json --- {cuentaOrigen: "100200300", cuentaDestino: "900800700", bancoDestino: "BAT-0088", monto: 150.75, moneda: "USD", concepto: "Pago de prueba", fechaSolicitud: "2026-10-01T14:32:10-06:00"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="exp-t8-tx-id"/>
                    <munit-tools:variable key="idempotencyKey" value="exp-t8-idem-key"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="post-transferencias-experience-impl-sf" doc:id="bb000073-0008-0008-0008-000000000073"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="bb000074-0008-0008-0008-000000000074"
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(422)]"
                message="httpStatus debe ser 422"/>
            <munit-tools:assert-that doc:id="bb000075-0008-0008-0008-000000000075"
                expression="#[payload.codigo]"
                is="#[MunitTools::equalTo('SALDO_INSUFICIENTE')]"
                message="payload.codigo debe ser SALDO_INSUFICIENTE"/>
        </munit:validation>

    </munit:test>

</mule>
