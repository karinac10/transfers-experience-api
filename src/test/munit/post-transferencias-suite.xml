    <!-- ================================================================
         T6 — exp-post-t6-process-caido-503
         Mock Process API lanza HTTP:CONNECTIVITY
         Sub-flow propaga el error → expectedErrorType lo captura
         ================================================================ -->
    <munit:test name="exp-post-t6-process-caido-503"
                description="POST transferencias: Process API no disponible → HTTP:CONNECTIVITY se propaga"
                expectedErrorType="HTTP:CONNECTIVITY"
                doc:id="bb000050-0006-0006-0006-000000000050">

        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:id="bb000051-0006-0006-0006-000000000051">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="POST Process API /PaymentOrder/Initiate"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="bb000052-0006-0006-0006-000000000052">
                <munit-tools:payload
                    mediaType="application/json"
                    value='#[output application/json --- {cuentaOrigen: "100200300", cuentaDestino: "900800700", bancoDestino: "BAT-0088", monto: 150.75, moneda: "USD", concepto: "Pago de prueba", fechaSolicitud: "2026-10-01T14:32:10-06:00"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="exp-t6-tx-id"/>
                    <munit-tools:variable key="idempotencyKey" value="exp-t6-idem-key"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="post-transferencias-experience-impl-sf" doc:id="bb000053-0006-0006-0006-000000000053"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="bb000054-0006-0006-0006-000000000054"
                expression="#[true]"
                is="#[MunitTools::equalTo(true)]"
                message="HTTP:CONNECTIVITY fue propagado correctamente (capturado por expectedErrorType)"/>
        </munit:validation>

    </munit:test>

