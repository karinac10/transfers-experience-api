<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <munit:config name="post-transferencias-suite" doc:id="bb000001-0001-0001-0001-000000000001"/>

    <!-- ================================================================
         T1 — exp-post-t1-happy-path-201
         Mock Process API retorna Completed + statusCode 200 + X-Payment-Order-Id
         Valida: httpStatus=201, payload.id, payload.estado=APROBADA
         ================================================================ -->
    <munit:test name="exp-post-t1-happy-path-201"
                description="POST transferencias: Process responde Completed → 201 APROBADA con id de orden"
                doc:id="bb000002-0001-0001-0001-000000000002">

        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:id="bb000003-0001-0001-0001-000000000003">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="POST Process API /PaymentOrder/Initiate"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/json"
                        value='#[output application/json --- {PayerProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "100200300"}}}}}, PayeeProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "900800700"}}}}}, PayeeBankReference: {PartyReference: {PartyIdentification: {PartyIdentification: {IdentifierValue: {Value: "BAT-0088"}}}}}, Amount: {AmountValue: {Value: "150.75"}, AmountCurrency: {Currencycode: "USD"}}, Currency: {Currencycode: "USD"}, DateType: "Creationdate", Date: {DateTimeContent: "2026-10-01T14:32:10-06:00"}, PaymentMechanismType: "ACH", PaymentInstructions: {PaymentInstructionType: "Domesticpayment", PaymentInstructionStatus: {PaymentInstructionStatusType: "Completed", PaymentInstructionStatus: {StatusDateTime: {DateTimeContent: "2026-10-18T20:00:00Z"}}}}, RemittanceInformation: {Text: "Pago de prueba"}}]'/>
                    <munit-tools:attributes
                        value='#[output application/java --- {statusCode: 200, headers: {"X-Payment-Order-Id": "test-order-e2e-uuid-001", "Location": "/payment-order/PaymentOrder/test-order-e2e-uuid-001/Retrieve"}}]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="bb000004-0001-0001-0001-000000000004">
                <munit-tools:payload
                    mediaType="application/json"
                    value='#[output application/json --- {cuentaOrigen: "100200300", cuentaDestino: "900800700", bancoDestino: "BAT-0088", monto: 150.75, moneda: "USD", concepto: "Pago de prueba", fechaSolicitud: "2026-10-01T14:32:10-06:00"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="exp-t1-tx-id"/>
                    <munit-tools:variable key="idempotencyKey" value="exp-t1-idem-key"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="post-transferencias-experience-impl-sf" doc:id="bb000005-0001-0001-0001-000000000005"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="bb000006-0001-0001-0001-000000000006"
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(201)]"
                message="httpStatus debe ser 201"/>
            <munit-tools:assert-that doc:id="bb000007-0001-0001-0001-000000000007"
                expression="#[payload.id]"
                is="#[MunitTools::equalTo('test-order-e2e-uuid-001')]"
                message="payload.id debe ser el X-Payment-Order-Id del header"/>
            <munit-tools:assert-that doc:id="bb000008-0001-0001-0001-000000000008"
                expression="#[payload.estado]"
                is="#[MunitTools::equalTo('APROBADA')]"
                message="payload.estado debe ser APROBADA"/>
        </munit:validation>

    </munit:test>

    <!-- ================================================================
         T2 — exp-post-t2-monto-negativo-400
         Validacion rechaza monto negativo antes de llamar Process API
         Valida: httpStatus=400, payload.codigo=VALIDACION_ERROR, http:request no fue llamado
         ================================================================ -->
    <munit:test name="exp-post-t2-monto-negativo-400"
                description="POST transferencias: monto negativo → 400 VALIDACION_ERROR sin llamar Process API"
                doc:id="bb000010-0002-0002-0002-000000000010">

        <munit:execution>
            <munit-tools:set-event doc:id="bb000011-0002-0002-0002-000000000011">
                <munit-tools:payload
                    mediaType="application/json"
                    value='#[output application/json --- {cuentaOrigen: "100200300", cuentaDestino: "900800700", bancoDestino: "BAT-0088", monto: -100.00, moneda: "USD", concepto: "Pago de prueba", fechaSolicitud: "2026-10-01T14:32:10-06:00"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="exp-t2-tx-id"/>
                    <munit-tools:variable key="idempotencyKey" value="exp-t2-idem-key"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="post-transferencias-experience-impl-sf" doc:id="bb000012-0002-0002-0002-000000000012"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="bb000013-0002-0002-0002-000000000013"
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(400)]"
                message="httpStatus debe ser 400"/>
            <munit-tools:assert-that doc:id="bb000014-0002-0002-0002-000000000014"
                expression="#[payload.codigo]"
                is="#[MunitTools::equalTo('VALIDACION_ERROR')]"
                message="payload.codigo debe ser VALIDACION_ERROR"/>
            <munit-tools:verify-call doc:id="bb000015-0002-0002-0002-000000000015"
                processor="http:request"
                times="0"
                message="Process API NO debe ser llamada cuando la validacion falla">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="POST Process API /PaymentOrder/Initiate"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

